rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read images
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Allow authenticated users to upload to their own character folder
    match /characters/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow unauthenticated uploads for testing (remove in production)
    match /characters/{userId}/{allPaths=**} {
      allow write: if true;
    }
  }
}
